    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-config-next": "16.2.1",
    "prettier": "latest",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "3.4.18",
    "typescript": "^5.8.3",
    "vitest": "5.0.5"
